# Gixxer.ai environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real secrets.

# ---- Core ------------------------------------------------------------------
# Public origin of the app (no trailing slash).
APP_URL=http://localhost:3000

# Session signing/encryption secret. At least 32 characters.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# MongoDB connection string (must include the database name).
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gixxer?appName=Gixxer
MONGODB_URI=mongodb://127.0.0.1:27017/gixxer

# ---- Google OAuth ----------------------------------------------------------
# Leave empty to show the Google button disabled. With both set, sign-in is live.
# Register <APP_URL>/api/auth/callback/google as an authorised redirect URI on the client.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- AI providers (server-side only) ---------------------------------------
# Groq runs chat, Think mode (a reasoning model) and voice transcription.
# Hugging Face generates images and embeds documents for retrieval.
# Leave one empty and the manager routes around it.
GROQ_API=
HUGGINGFACE_API_KEY=

# Optional model overrides. The defaults are verified against the live APIs.
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_THINK_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Unsplash (reference-photo search only, never generation) --------------
# Server-side only. The access key is the one the server sends to Unsplash;
# the other two are never used by the app and never reach the browser.
UNSPLASH_APPLICATION_ID=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# ---- Firecrawl (Chatbot Pro website crawling, server-side only) --------------
# Create a key at https://www.firecrawl.dev/app/api-keys. Unset hides the
# "Website URL" knowledge option.
FIRECRAWL_API_KEY=

# ---- Scheduled prompts -----------------------------------------------------
# Due schedules run when their owner opens the workspace. To run them on time
# for everyone, have a scheduler POST /api/cron every few minutes with
# "Authorization: Bearer <CRON_SECRET>". Unset means the endpoint is closed.
# CRON_SECRET=

# Replaces every provider with a local stand-in. Only for automated tests.
# AI_MOCK=1

# ---- Test-only knob -------------------------------------------------------
# Multiplies the per-IP auth rate limits. Automated browser runs send every
# request from one address, so the end-to-end suite raises this. Per-email
# limits are never scaled. Do NOT set this in production.
# AUTH_RATE_LIMIT_IP_SCALE=1
